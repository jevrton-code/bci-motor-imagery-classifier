# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.python-version

# --- Raw EEG data and MOABB / MNE caches (NEVER commit) -------------------
# Raw EEG recordings and benchmark caches must not be committed. MOABB / MNE
# download data into local caches on first use; keep all of it local.
data/
moabb_data/
mne_data/
MNE-*/
.mne/
*.edf
*.fif
*.fif.gz
*.gdf
*.bdf
*.set
*.vhdr
*.vmrk
*.eeg
# Large NumPy caches (generated feature/array caches). Small intentional
# committed arrays should be force-added if ever needed.
*.npy
*.npz

# --- Generated benchmark outputs ------------------------------------------
# Ignore generated data outputs by default...
results/*.csv
figures/*.png
figures/*.svg
figures/*.pdf
# Local results cache directory.
.cache/
results_cache/
!results/.gitkeep
!figures/.gitkeep
# ...but DO commit the small, curated, reproducible result tables and figures
# so the public portfolio repo can display results. Raw EEG data and MOABB/MNE
# caches stay ignored via the rules above and below.
!results/baseline_results.csv
!results/aggregate_scores.csv
!figures/per_subject_scores.png
!figures/pipeline_comparison.png
!figures/score_distribution.png

# --- Working / planning docs (kept local per project decision) ------------
# The docs/ folder holds local planning documents and working notes that are
# intentionally not published to the public repository.
docs/

